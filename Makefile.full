# Makefile for full diarization with embeddings

ONNX_RT_DIR = ./onnxruntime-osx-arm64-1.23.0
ONNX_RT_INCLUDE = $(ONNX_RT_DIR)/include
ONNX_RT_LIB = $(ONNX_RT_DIR)/lib

CC = clang
CFLAGS = -I$(ONNX_RT_INCLUDE) -Wall -O2
LDFLAGS = -L$(ONNX_RT_LIB) -lonnxruntime -Wl,-rpath,$(ONNX_RT_LIB)
FRAMEWORKS = -framework Accelerate -framework CoreML -framework Foundation

TARGET = poc_diarize_full

all: $(TARGET)

$(TARGET): poc_diarize_full.c
	$(CC) $(CFLAGS) poc_diarize_full.c -o $(TARGET) $(LDFLAGS) $(FRAMEWORKS)
	@echo "✓ Compiled successfully!"

run: $(TARGET)
	./$(TARGET) "/Users/aleksander/Downloads/nagr/New Recording 43.m4a"

clean:
	rm -f $(TARGET)

.PHONY: all run clean
